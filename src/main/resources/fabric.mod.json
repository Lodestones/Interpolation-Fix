{
  "schemaVersion": 1,
  "id": "interpolationfix",
  "version": "${version}",
  "name": "Interpolation Fix",
  "description": "Brings back the smooth 26.2 entity interpolation on servers that opt in. Fixes the player and mob stutter introduced in 26.3 (MC-311974).",
  "authors": [
    "Apollo30"
  ],
  "contact": {
    "homepage": "https://github.com/Lodestones/Interpolation-Fix",
    "sources": "https://github.com/Lodestones/Interpolation-Fix",
    "issues": "https://github.com/Lodestones/Interpolation-Fix/issues",
    "discord": "https://discord.com/invite/X8KP2XMdqu"
  },
  "license": "MIT",
  "icon": "assets/interpolationfix/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "gg.lode.interpolationfix.InterpolationFix"
    ],
    "modmenu": [
      "gg.lode.interpolationfix.ModMenuIntegration"
    ]
  },
  "mixins": [
    "interpolationfix.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  },
  "suggests": {
    "modmenu": "*"
  }
}
